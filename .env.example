APP_ENV=local
LOG_LEVEL=INFO
# Per-process log files (<LOG_DIR>/api.log, ...) rotated daily at UTC midnight.
LOG_DIR=logs
LOG_RETENTION_DAYS=14
APP_DOMAIN=localhost

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_USER_ID=
TWITCH_USERNAME=
TWITCH_CHANNELS=
TWITCH_INGESTION_MODE=irc

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CHAT_TOPIC=twitch.chat.messages
KAFKA_TRANSCRIPT_TOPIC=twitch.stream.transcripts
KAFKA_CONSUMER_GROUP=clickhouse-chat-writer
KAFKA_TRANSCRIPT_CONSUMER_GROUP=clickhouse-transcript-writer

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=twitch_analyze
CLICKHOUSE_DATABASE=twitch_analyze

RECENT_MESSAGE_LIMIT=500
ENABLE_TWITCH_INGESTION=true
CORS_ORIGINS=http://localhost:5173

# Optional: when set, mutating API endpoints (and reading/saving settings) require this
# value in the X-API-Key header. The dashboard sends it once entered under Settings.
API_AUTH_TOKEN=

# Values saved from the dashboard Settings page; they override this file. Relative
# paths resolve from the backend working directory. Kafka/ClickHouse connection
# settings and API_AUTH_TOKEN can only be set here, never from the dashboard.
SETTINGS_OVERRIDES_FILE=data/settings-overrides.json

# Feature flags (also toggleable from the dashboard Settings page).
ENABLE_SUMMARIES=true
ENABLE_TRANSCRIPTION=true
ENABLE_VOD_ANALYSIS=true
ENABLE_VOD_LABELS=true

# Grafana admin password. Optional in dev (defaults to "admin"); required in prod
# (docker-compose.prod.yml refuses to start without it).
GRAFANA_ADMIN_PASSWORD=

OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.2
OPENAI_SUMMARY_MAX_MESSAGES=250
OPENAI_TIMEOUT_SECONDS=60
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Max concurrently running transcription jobs (further starts return 429).
TRANSCRIPTION_MAX_CONCURRENT_JOBS=3

ENABLE_AUDIO_CAPTURE=false
AUDIO_CAPTURE_CHANNELS=
AUDIO_SEGMENT_SECONDS=30
AUDIO_RETENTION_MINUTES=60
AUDIO_CHUNK_DIR=/tmp/twitch-audio

# VOD chat-replay analysis (Twitch web GQL API; public client id, no credentials needed).
# Twitch web GQL endpoint used to fetch VOD metadata and chat replay.
TWITCH_GQL_URL=https://gql.twitch.tv/gql
# Public Twitch Client-ID sent with GQL requests. The browser web id
# (kimne78kx3ncx6brgo4mv6wki5h1ko) fails Twitch's integrity check on cursor-paged
# chat replay after the first page; this one (used by TwitchDownloader) does not.
TWITCH_GQL_CLIENT_ID=kd1unb4b3q4t58fwlpcbzcbnm76a8fp
# Persisted-query sha256 hash for the VideoCommentsByOffsetOrCursor operation.
TWITCH_GQL_COMMENTS_QUERY_HASH=b70a3591ff0f4e0313d126c6a1502d79a1c02baebb288227c582044aa76adf6a
# Max concurrently running VOD analysis jobs (1-10; further starts return 429).
VOD_MAX_CONCURRENT_JOBS=2
# Delay between chat-replay page fetches, in seconds.
VOD_FETCH_PAGE_DELAY_SECONDS=0.1
# Max retries per chat-replay page before the job fails.
VOD_FETCH_MAX_RETRIES=5
# Hard cap on comments fetched per VOD.
VOD_MAX_COMMENTS=500000
# Max activity buckets per VOD (bucket size grows to stay under this).
VOD_MAX_BUCKETS=720
# Max chat peaks reported per VOD (1-50).
VOD_MAX_PEAKS=12
# Max seconds to wait for ClickHouse to catch up with produced VOD comments.
VOD_CATCHUP_TIMEOUT_SECONDS=900
# Seconds between ClickHouse catch-up polls.
VOD_CATCHUP_POLL_SECONDS=2
# Consecutive unchanged catch-up polls required before analysis starts.
VOD_CATCHUP_STABLE_POLLS=5
# Model for optional LLM peak titles; empty falls back to OPENAI_SUMMARY_MODEL.
OPENAI_VOD_LABEL_MODEL=

# Live-VOD clips (Clips tab): save the last N minutes of a live channel's in-progress
# VOD as an MP4. Needs streamlink (pip dependency) and ffmpeg on the backend host.
# Where finished clips (MP4 + JSON sidecar) are stored; reloaded at startup.
CLIP_OUTPUT_DIR=/tmp/twitch-clips
# Max concurrently running clip jobs (1-10; further starts return 429).
CLIP_MAX_CONCURRENT_JOBS=2
# Longest clip a request may ask for, in minutes (1-60).
CLIP_MAX_DURATION_MINUTES=15
# streamlink quality for the VOD stream: best, 720p60, 480p30, audio_only, ...
CLIP_STREAM_QUALITY=best
# Seconds allowed for streamlink to resolve the VOD playlist URL.
CLIP_RESOLVE_TIMEOUT_SECONDS=60
# Minimum seconds allowed for the ffmpeg download (grows with the clip length).
CLIP_DOWNLOAD_TIMEOUT_SECONDS=600

# Streams tab: keyless "is this streamer live?" checks on Twitch (web GQL), Kick
# (kick.com/api/v2/channels) and YouTube (youtube.com/@handle/live). No API keys needed.
ENABLE_STREAM_STATUS=true
# Seconds each platform gets to answer (1-60).
STREAM_STATUS_TIMEOUT_SECONDS=10
# Seconds a live-status answer is reused before the platform is asked again (0 disables).
STREAM_STATUS_CACHE_SECONDS=30
