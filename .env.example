APP_ENV=local
LOG_LEVEL=INFO
APP_DOMAIN=localhost

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_USER_ID=
TWITCH_USERNAME=
TWITCH_CHANNELS=
TWITCH_INGESTION_MODE=irc

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CHAT_TOPIC=twitch.chat.messages
KAFKA_TRANSCRIPT_TOPIC=twitch.stream.transcripts
KAFKA_CONSUMER_GROUP=clickhouse-chat-writer
KAFKA_TRANSCRIPT_CONSUMER_GROUP=clickhouse-transcript-writer

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=twitch_analyze
CLICKHOUSE_DATABASE=twitch_analyze

RECENT_MESSAGE_LIMIT=500
ENABLE_TWITCH_INGESTION=true
CORS_ORIGINS=http://localhost:5173

OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.2
OPENAI_SUMMARY_MAX_MESSAGES=250
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

ENABLE_AUDIO_CAPTURE=false
AUDIO_CAPTURE_CHANNELS=
AUDIO_SEGMENT_SECONDS=30
AUDIO_RETENTION_MINUTES=60
AUDIO_CHUNK_DIR=/tmp/twitch-audio
